<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 承載設定（HttpPlatformHandler）。
  IIS 收到請求後，用「打包在專案內的 Python」起 api\app.py，並把請求轉給它；
  app.py 以 uvicorn 承載 FastAPI，同時服務前端（public\）與 /api。
  目標機只需安裝 IIS 的 HttpPlatformHandler 模組，
  不需安裝 Python 或任何 Python 套件（全部在 runtime\ 內）。
  部署前先在有網路的建置機執行 build\setup_runtime.ps1 產生 runtime\。
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpplatformhandler" path="*" verb="*" modules="httpPlatformHandler"
           resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="%{APPL_PHYSICAL_PATH}runtime\python\python.exe"
                  arguments="&quot;%{APPL_PHYSICAL_PATH}api\app.py&quot;"
                  stdoutLogEnabled="true"
                  stdoutLogFile="%{APPL_PHYSICAL_PATH}logs\python"
                  startupTimeLimit="60"
                  requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="PYTHONPATH"
                             value="%{APPL_PHYSICAL_PATH}runtime\site-packages;%{APPL_PHYSICAL_PATH}api" />
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
